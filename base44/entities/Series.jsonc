{
  "name": "Series",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "book_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ongoing",
        "completed",
        "hiatus"
      ],
      "default": "ongoing"
    }
  },
  "required": [
    "title"
  ]
}