{
  "name": "ReaderMatch",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "matched_email": {
      "type": "string"
    },
    "match_percent": {
      "type": "number"
    },
    "shared_genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shared_books": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "personality_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "liked",
        "accepted",
        "rejected",
        "skipped",
        "ended"
      ],
      "default": "pending"
    },
    "liked_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "book_id": {
      "type": "string"
    },
    "book_title": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "matched_email"
  ]
}