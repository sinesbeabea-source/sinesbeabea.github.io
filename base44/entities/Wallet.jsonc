{
  "name": "Wallet",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "total_earned": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    },
    "level": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "bronze"
    }
  },
  "required": [
    "user_email"
  ]
}