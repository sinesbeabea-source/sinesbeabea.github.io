    },
    "avatar_url": {
      "type": "string"
    },
    "avatar_type": {
      "type": "string",
      "enum": [
        "uploaded",
        "default"
      ],
      "default": "default"
    },
    "default_avatar_id": {
      "type": "string"
    }
